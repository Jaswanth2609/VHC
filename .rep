modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hydration Coach"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run_hydration_coach"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hydration Coach GUI"

[[workflows.workflow]]
name = "Hydration Coach"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python hydration_coach.py"

[[workflows.workflow]]
name = "run_hydration_coach"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 hydration_coach.py"

[[workflows.workflow]]
name = "Hydration Coach GUI"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python hydration_coach_gui.py"

[deployment]
run = ["sh", "-c", "python hydration_coach.py"]

[agent]
expertMode = true
